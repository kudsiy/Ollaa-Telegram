# Copy this file to .env and fill in the values.
# .env is never committed to git. This example file is, so keep it free of real values.

# ── Telegram (from https://my.telegram.org) ──────────────────────
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# ── PostgreSQL database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ollaa
# Everyday login used by all scripts: owns the Ollaa tables, not a superuser.
DB_USER=ollaa_user
DB_PASSWORD=
# Administrator login: only for backups and database/export_schema.py.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# ── Gemini (Google AI Studio API key, used by extract_images.py) ─
GEMINI_API_KEY=
