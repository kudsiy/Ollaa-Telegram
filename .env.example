# Copy this file to .env and fill in the values.
# .env is never committed to git. This example file is, so keep it free of real values.

# ── Telegram (from https://my.telegram.org) ──────────────────────
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# ── PostgreSQL database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ollaa
DB_USER=postgres
DB_PASSWORD=

# Second database login "ollaa_user". No script uses it yet (see STATUS.md, task S9).
OLLAA_USER_PASSWORD=

# ── Gemini (Google AI Studio API key, used by extract_images.py) ─
GEMINI_API_KEY=
